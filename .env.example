# Copy this file to .env and fill in real values.
# Never commit .env to git (already ignored via .gitignore).

# MongoDB Atlas connection string
MONGODB_URI=mongodb://username:password@host1:27017,host2:27017,host3:27017/dbname?ssl=true&authSource=admin&replicaSet=<replica-set-id>

# Port this Express API listens on
PORT=8000

# URL where the frontend calls this API (no trailing slash).
# In dev: http://localhost:3000
# In production (this project's live frontend):
# https://booknook-frontend-two.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# ============================================
# FRONTEND CO-DEPLOY VARIABLES (set on the
# FRONTEND platform, e.g. Vercel > Project >
# Settings > Environment Variables):
# NEXT_PUBLIC_API_URL = this deployed server's
# public URL (no trailing slash), e.g.
# https://booknook-server.vercel.app
# (consumed by the frontend's src/lib/backend.ts)
# ============================================
