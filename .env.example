# Copy this file to .env and fill in real values.
# Never commit .env to git (already ignored via .gitignore).

# MongoDB Atlas connection string
MONGODB_URI=mongodb://username:password@host1:27017,host2:27017,host3:27017/dbname?ssl=true&authSource=admin&replicaSet=<replica-set-id>

# Port this Express API listens on
PORT=8000

# URL where the frontend calls this API (no trailing slash).
# In dev: http://localhost:3000
# In production: your deployed frontend URL
BETTER_AUTH_URL=http://localhost:3000
